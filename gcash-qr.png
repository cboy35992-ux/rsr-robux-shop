*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,sans-serif;background:#0d0618;color:#fff}.hidden{display:none!important}.auth{min-height:100vh;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 20% 20%,#4a1b8f55,transparent 35%),#0d0618}.auth-card,.card{background:#171022;border:1px solid #392653;border-radius:22px;box-shadow:0 18px 55px #0007}.auth-card{width:min(460px,100%);padding:28px}.brand{font-size:28px;font-weight:800;margin-bottom:8px}.muted{color:#b8aac9}.tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:22px 0}.tab,.btn{border:0;border-radius:12px;padding:13px 16px;font-weight:700;cursor:pointer}.tab{background:#241833;color:#c7b5da}.tab.active,.btn-primary{background:linear-gradient(135deg,#7c3aed,#a855f7);color:#fff}.field{margin:14px 0}.field label{display:block;margin-bottom:7px;color:#d7cbe4}.input{width:100%;padding:13px 14px;border-radius:12px;border:1px solid #4a3564;background:#0f0a16;color:#fff}.error{background:#4a1820;color:#ffd4da;padding:11px;border-radius:10px;margin:10px 0}.shell{display:grid;grid-template-columns:250px 1fr;min-height:100vh}.side{padding:22px;background:#11091b;border-right:1px solid #352347}.side button{display:block;width:100%;text-align:left;margin:8px 0;background:transparent;color:#d5c9e1;border:0;padding:12px;border-radius:10px}.side button:hover,.side button.active{background:#2a193d}.main{padding:28px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.card{padding:20px}.stat strong{display:block;font-size:30px;margin-top:8px}.order-form{display:grid;grid-template-columns:1fr 1fr;gap:16px}.full{grid-column:1/-1}.btn{background:#2a1c3b;color:#fff}.btn-danger{background:#84253a}.btn-success{background:#157347}.orders{display:grid;gap:12px}.order{display:grid;grid-template-columns:1.2fr .8fr .8fr auto;gap:12px;align-items:center}.receipt{max-width:260px;border-radius:12px}.chat{height:360px;overflow:auto;background:#0f0a16;padding:12px;border-radius:12px}.msg{padding:9px 11px;background:#2a193d;border-radius:12px;margin:7px 0}.msg.admin{background:#4b2371}.toast{position:fixed;right:20px;bottom:20px;background:#20152f;padding:12px 16px;border-radius:10px}.install{margin-top:12px;width:100%}@media(max-width:900px){.shell{grid-template-columns:1fr}.side{position:sticky;top:0;z-index:5;display:flex;gap:8px;overflow:auto;border-right:0;border-bottom:1px solid #352347}.side .brand{display:none}.side button{min-width:max-content}.grid{grid-template-columns:1fr 1fr}.order-form{grid-template-columns:1fr}.order{grid-template-columns:1fr}.main{padding:16px}}@media(max-width:520px){.grid{grid-template-columns:1fr}.auth-card{padding:20px}.main{padding:12px}}
