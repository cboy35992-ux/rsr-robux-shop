const {spawn}=require('child_process');const fs=require('fs');const path=require('path');const tmp=path.join(__dirname,'test-data');fs.rmSync(tmp,{recursive:true,force:true});const p=spawn(process.execPath,['server.js'],{cwd:__dirname,env:{...process.env,PORT:'3456',DATA_DIR:tmp,JWT_SECRET:'fixed-test-secret',ADMIN_EMAIL:'admin@test.com',ADMIN_PASSWORD:'Admin123!'}});const wait=ms=>new Promise(r=>setTimeout(r,ms));(async()=>{await wait(500);const reg=await fetch('http://127.0.0.1:3456/api/auth/register',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name:'Test User',email:'test@example.com',password:'secret12'})});if(reg.status!==201)throw new Error('register '+reg.status+' '+await reg.text());const rd=await reg.json();const me=await fetch('http://127.0.0.1:3456/api/me',{headers:{authorization:'Bearer '+rd.token}});if(me.status!==200)throw new Error('session restore failed');const login=await fetch('http://127.0.0.1:3456/api/auth/login',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email:'test@example.com',password:'secret12'})});if(login.status!==200)throw new Error('login failed');const admin=await fetch('http://127.0.0.1:3456/api/auth/login',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email:'admin@test.com',password:'Admin123!'})});if(admin.status!==200)throw new Error('admin login failed');console.log('PASS: register, customer login, admin login, persistent session');p.kill();fs.rmSync(tmp,{recursive:true,force:true})})().catch(e=>{console.error(e);p.kill();process.exit(1)})
